{
  "expo": {
    "name": "FF Scanner",
    "slug": "ff-scanner-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16a34a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.farmersfactory.scanner",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes and barcodes on boxes.",
        "NSPhotoLibraryUsageDescription": "This app accesses photos for QC evidence.",
        "NSLocationWhenInUseUsageDescription": "FF Scanner uses your location to auto-select the nearest hub."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16a34a"
      },
      "package": "com.farmersfactory.scanner",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FF Scanner to access your camera to scan box labels."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FF Scanner uses photos to document wastage evidence.",
          "cameraPermission": "FF Scanner uses the camera to photograph wastage items."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FF Scanner uses your location to auto-select the nearest hub."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#dc2626",
          "sounds": []
        }
      ]
    ],
    "scheme": "ff-scanner",
    "extra": {
      "eas": {
        "projectId": "e51bc739-e127-4b69-b90d-f19a404a4684"
      }
    },
    "owner": "igo2026"
  }
}
